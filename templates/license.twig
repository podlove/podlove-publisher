{#
	Include example:
	{% include '@core/license.twig' %}

	You can pass in a license to determine which one is displayed:
	{% include '@core/license.twig' with {'license': podcast.license} %}	
#}
{% if license is not defined %}
	{% if episode is not null and episode.license.valid %}
		{% set license = episode.license %}
	{% else %}
	    {% set license = podcast.license %}
	{% endif %}
{% endif %}

{% if license.valid %}
	{% if license.creativeCommons %}
		<div class="podlove_cc_license">
			<img src="{{ license.imageUrl|esc_url }}" alt="{{ __('License', 'podlove-podcasting-plugin-for-wordpress')|e('html_attr') }}" />
			<p>
				{{ __('This work is licensed under a %s', 'podlove-podcasting-plugin-for-wordpress')|e('html')|format('<a rel="license" href="' ~ license.url|esc_url ~ '">' ~ license.name|e('html') ~ '</a>')|raw }}
			</p>
		</div>
	{% else %}
	    {{ __('This work is licensed under the %s license.', 'podlove-podcasting-plugin-for-wordpress')|e('html')|format('<a href="' ~ license.url|esc_url ~ '">' ~ license.name|e('html') ~ '</a>')|raw }}
	{% endif %}
{% else %}
    <div class="podlove_license">
		<p style="color: red;">
			{{ __('This work is (not yet) licensed, as no license was chosen.', 'podlove-podcasting-plugin-for-wordpress')|e('html') }}
		</p>
    </div>
{% endif %}
