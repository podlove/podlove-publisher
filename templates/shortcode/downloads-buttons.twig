<ul class="episode_download_list">
	<li>{{ __('Download:', 'podlove-podcasting-plugin-for-wordpress')|e('html') }}</li>
	{% for file in episode.files %}
	    {% set asset = file.asset %}
	    {% if asset.downloadable and file.active %}
			<li>
				<a href="{{ file.publicUrl("download", "buttonlist")|esc_url }}">{{ asset.title|e('html') }}<span class="size">{{ file.size|formatBytes|e('html') }}</span></a>
			</li>
	    {% endif %}
	{% endfor %}
</ul>
<div style="clear: both"></div>
