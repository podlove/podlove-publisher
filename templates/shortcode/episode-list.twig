<table>
    <thead>
        <th></th>
        <th>{{ __('Date', 'podlove-podcasting-plugin-for-wordpress')|e('html') }}</th>
        <th>{{ __('Title', 'podlove-podcasting-plugin-for-wordpress')|e('html') }}</th>
        <th>{{ __('Duration', 'podlove-podcasting-plugin-for-wordpress')|e('html') }}</th>
    </thead>
    <tbody>
    {% for episode in podcast.episodes %}
        <tr class="podcast_archive_element">
            <td class="thumbnail">
                {{ episode.image({fallback: true}).html({width: 64, height: 64})|raw }}
            </td>
            <td class="date">
                <span class="release_date">
                    {{ episode.publicationDate|e('html') }}
                </span>
            </td>
            <td class="title">
                <a href="{{ episode.url|esc_url }}">
                    <strong>{{ episode.title|e('html') }}</strong><br>
                    {{ episode.subtitle|e('html') }}
                </a>
            </td>
            <td class="duration">
                {% set duration = episode.duration %}
                {{ duration.hours|e('html') }}:{{ duration.minutes|padLeft("0",2)|e('html') }}:{{ duration.seconds|padLeft("0",2)|e('html') }}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<style type="text/css">
.podcast_archive_element .thumbnail {
    width: 64px;
    padding: 5px !important;
}

.podcast_archive_element td {
    vertical-align: top;
}
</style>
