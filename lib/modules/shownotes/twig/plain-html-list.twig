<ul>
	{% for entry in episode.shownotes %}
		<li>
			{% if entry.type == "link" %}
				{% set entry_url = entry.url|esc_url %}
				{% if entry_url %}
					<a href="{{ entry_url }}">{{ (entry.title ? entry.title : entry.url)|e('html') }}</a>
				{% else %}
					{{ (entry.title ? entry.title : entry.url)|e('html') }}
				{% endif %}
			{% elseif entry.type == "topic" %}
				<strong>{{ entry.title|e('html') }}</strong>
			{% endif %}
		</li>
	{% endfor %}
</ul>
