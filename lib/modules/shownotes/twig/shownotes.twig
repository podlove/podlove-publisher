{% if is_feed() %}

	{% include '@shownotes/plain-html-list.twig' %}

{% else %}

	<style>
		.psn-entry {
			display: flex;
			align-items: start;
			margin-bottom: 8px;
		}
		.psn-icon {
			width: 16px;
			height: 16px;
			margin-right: 5px;
			margin-top: 5px;
			flex-shrink: 0;
		}
		.psn-icon-default {
			background: rgb(209, 213, 219);
		}
		a.psn-link {
			text-decoration: none !important;
			font-size: 16px;
			line-height: 24px;
		}
	</style>

	<ul>
		{% for entry in episode.shownotes %}
			<li class="psn-entry">
				{% if entry.type == "link" %}
					{% if entry.icon %}
						{% set icon_url = entry.icon|esc_url %}
						{% if icon_url %}
							<img class="psn-icon" src="{{ icon_url }}"/>
						{% else %}
							<div class="psn-icon psn-icon-default">&nbsp;</div>
						{% endif %}
					{% else %}
						<div class="psn-icon psn-icon-default">&nbsp;</div>
					{% endif %}
					{% set entry_url = entry.url|esc_url %}
					{% if entry_url %}
						<a class="psn-link" href="{{ entry_url }}">{{ (entry.title ? entry.title : entry.url)|e('html') }}</a>
					{% else %}
						<span class="psn-link">{{ (entry.title ? entry.title : entry.url)|e('html') }}</span>
					{% endif %}
				{% elseif entry.type == "topic" %}
					<strong>{{ entry.title|e('html') }}</strong>
				{% endif %}
			</li>
		{% endfor %}
	</ul>

{% endif %}
