<ul class="podcast_services">
{% for service in podcast.services({category: "social"}) %}
	<li>
		<a href="{{ service.profileUrl }}" title="{{ service.description|e('html_attr') }}">
			{{
				service.image.html({
					width: 16,
					alt: service.title ~ " Icon"
				}) 
			}} {{ service.title|e('html') }}
        </a>
    </li>
{% endfor %}
</ul>

<style>
.podcast_services li {
	list-style: none;
}
</style>
